# Netlify headers for the web app. Expo copies public/ into dist/.
# wa-sqlite needs SharedArrayBuffer, which needs cross-origin isolation
# (the same two headers metro.config.js sets for the dev server).
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# the bundles have a hash in their names, so they never change
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
