{
  "expo": {
    "name": "Nura",
    "slug": "nura",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nura",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/icon-nura.png",
    "splash": {
      "image": "./assets/brand/nura-logo-tight.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1029"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.nura",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": []
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "com.yourname.nura",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon-nura-fg.png",
        "backgroundColor": "#0B1029"
      },
      "permissions": [
        "READ_CALENDAR"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#FF6B35"
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-calendar",
        {
          "calendarPermission": "Nura reads your calendar to tell you how long you have before your next commitment. It never writes to it, and nothing leaves your phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
